{
  "type": "module",
  "scripts": {
    "test": "jest",
    "build": "node scripts/build-runtime.mjs",
    "minify": "terser synact.js -o synact.min.js -c -m",
    "dist": "npm run build && npm run minify",
    "build:docs": "esbuild docs/app/app.js --bundle --minify --format=esm --keep-names --outfile=bundled.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.6",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "terser": "^5.20.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
